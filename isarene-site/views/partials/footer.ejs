</main>
<footer class="footer-hw">
  <svg class="footer-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill="#1f2735" d="M0,32 C240,70 480,0 720,18 C960,36 1200,70 1440,26 L1440,70 L0,70 Z"></path>
  </svg>
  <span class="footer-glow"></span>
  <span class="footer-glow-2"></span>
  <div class="container footer-top">
    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <a class="hw-logo" href="/" aria-label="<%= site.name %> home"><img src="<%= site.img.logo %>" alt="<%= site.name %>" class="logo-img logo-img-footer" width="150" height="48" loading="lazy"></a>
        <p class="mt-3">Isarene Home Care Services is dedicated to providing compassionate, reliable, and personalized in-home care throughout Massachusetts. Our mission is to bring reliable, dignified care to the families in our community.</p>
        <div class="footer-social mt-3">
          <a href="<%= site.social.instagram %>" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i></a>
          <a href="<%= site.social.youtube %>" aria-label="YouTube" target="_blank" rel="noopener noreferrer"><i class="bi bi-youtube"></i></a>
        </div>
        <div class="footer-badges">
          <span class="footer-badge"><i class="bi bi-patch-check-fill"></i> MA-registered non-medical agency</span>
          <span class="footer-badge"><i class="bi bi-clock-fill"></i> 24/7 availability</span>
        </div>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <h6>Quick Links</h6>
        <ul>
          <li><a class="footer-link" href="/about"><i class="bi bi-caret-right-fill"></i>About Us</a></li>
          <li><a class="footer-link" href="/services"><i class="bi bi-caret-right-fill"></i>Services</a></li>
          <li><a class="footer-link" href="/blogs"><i class="bi bi-caret-right-fill"></i>Blog</a></li>
          <li><a class="footer-link" href="/gallery"><i class="bi bi-caret-right-fill"></i>Gallery</a></li>
          <li><a class="footer-link" href="/employment"><i class="bi bi-caret-right-fill"></i>Careers</a></li>
          <li><a class="footer-link" href="/contact"><i class="bi bi-caret-right-fill"></i>Contact</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <h6>Services</h6>
        <ul>
          <% Object.values(site.services).forEach(function (s) { %>
          <li><a class="footer-link" href="/services/<%= s.slug %>"><i class="bi bi-caret-right-fill"></i><%= s.short %></a></li>
          <% }) %>
          <li><a class="footer-link" href="/faq"><i class="bi bi-caret-right-fill"></i>FAQs</a></li>
        </ul>
      </div>
      <div class="col-md-6 col-lg-4">
        <h6>Get In Touch</h6>
        <div class="footer-contact-item"><span class="ic"><i class="bi bi-geo-alt-fill"></i></span><span><%= site.address %></span></div>
        <div class="footer-contact-item"><span class="ic"><i class="bi bi-envelope-fill"></i></span><a class="footer-plain" href="mailto:<%= site.email %>"><%= site.email %></a></div>
        <div class="footer-contact-item"><span class="ic"><i class="bi bi-telephone-fill"></i></span><span><a class="footer-plain" href="tel:<%= site.phonePrimary.tel %>"><%= site.phonePrimary.display %></a> &middot; <a class="footer-plain" href="tel:<%= site.phoneSecondary.tel %>"><%= site.phoneSecondary.display %></a></span></div>
        <h6 class="mt-4">Newsletter</h6>
        <form class="newsletter-input" data-ajax-form action="/api/newsletter" method="post" novalidate>
          <input type="email" name="email" placeholder="Your email address" aria-label="Email for newsletter" required>
          <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" aria-label="Subscribe"><i class="bi bi-arrow-right"></i></button>
        </form>
        <div class="newsletter-note" role="status" aria-live="polite" data-form-status><i class="bi bi-shield-check"></i> No spam. Unsubscribe anytime.</div>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div>&copy; <%= new Date().getFullYear() %> Isarene Home Care Services. All rights reserved.</div>
        <div class="footer-bottom-links mt-2"><a href="/privacy-policy">Privacy Policy</a><a href="/terms">Terms of Use</a><a href="/faq">FAQs</a></div>
      </div>
      <div class="text-md-end small opacity-75">Serving Billerica, MA and surrounding communities</div>
    </div>
  </div>
</footer>

<div class="mobile-donate-bar">
  <a href="tel:<%= site.phonePrimary.tel %>" class="btn-hw-outline"><i class="bi bi-telephone-fill"></i> Call</a>
  <a href="/contact#request" class="btn-hw-primary">Request Care <i class="bi bi-arrow-right"></i></a>
</div>

<div id="scrollTop" role="button" aria-label="Scroll to top" tabindex="0">
  <svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="23"></circle><circle class="progress" cx="26" cy="26" r="23"></circle></svg>
  <i class="bi bi-arrow-up"></i>
</div>

<script src="/js/bootstrap.bundle.min.js"></script>
<script src="/vendor/aos/aos.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
