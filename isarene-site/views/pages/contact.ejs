<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/pagehero', { icon: 'bi-envelope-fill', eyebrow: 'Contact Us', heading: 'We\u2019d love to hear from you', lead: 'Request a care assessment, ask a question, or call us any time. We are available 24/7 for home care services.' }) %>
<section class="section-pad pt-4"><div class="container"><div class="row g-5">
  <div class="col-lg-5" data-aos="fade-right">
    <div class="contact-card">
      <div class="contact-info-item"><span class="ic"><i class="bi bi-telephone-fill"></i></span><div><strong>Call us</strong><div class="text-muted small"><a href="tel:<%= site.phonePrimary.tel %>"><%= site.phonePrimary.display %></a><br><a href="tel:<%= site.phoneSecondary.tel %>"><%= site.phoneSecondary.display %></a></div></div></div>
      <div class="contact-info-item"><span class="ic"><i class="bi bi-envelope-fill"></i></span><div><strong>Email</strong><div class="text-muted small"><a href="mailto:<%= site.email %>"><%= site.email %></a></div></div></div>
      <div class="contact-info-item"><span class="ic"><i class="bi bi-geo-alt-fill"></i></span><div><strong>Office</strong><div class="text-muted small"><%= site.address %></div></div></div>
      <div class="contact-info-item"><span class="ic"><i class="bi bi-clock-fill"></i></span><div><strong>Hours</strong><div class="text-muted small"><%= site.hours %></div></div></div>
      <iframe class="map-frame" title="Map to Isarene Home Care Services" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=258+Salem+Rd+Suite+8+Billerica+MA+01862&output=embed"></iframe>
    </div>
  </div>
  <div class="col-lg-7" data-aos="fade-left" id="request">
    <div class="contact-card">
      <h2 class="font-display fw-bold h4">Request a care assessment</h2>
      <p class="text-muted small mb-4">Tell us how to reach you and we will call to learn about your needs.</p>
      <%- include('../partials/request-form') %>
    </div>
    <div class="contact-card mt-4">
      <h2 class="font-display fw-bold h5">Just have a question?</h2>
      <form data-ajax-form action="/api/contact" method="post" novalidate class="mt-3">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label small fw-semibold" for="c-name">Name</label><input class="form-control form-control-hw" id="c-name" name="name" autocomplete="name" required></div>
          <div class="col-md-6"><label class="form-label small fw-semibold" for="c-email">Email</label><input type="email" class="form-control form-control-hw" id="c-email" name="email" autocomplete="email" required></div>
          <div class="col-12"><label class="form-label small fw-semibold" for="c-msg">Message</label><textarea class="form-control form-control-hw" id="c-msg" name="message" rows="4" required></textarea></div>
          <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="col-12"><button class="btn-hw-outline w-100 justify-content-center" type="submit">Send message <i class="bi bi-send"></i></button></div>
          <div class="col-12" role="status" aria-live="polite" data-form-status></div>
        </div>
      </form>
    </div>
  </div>
</div></div></section>
<%- include('../partials/footer') %>
