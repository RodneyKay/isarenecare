<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<header class="blog-hero">
  <span class="blob blob-a"></span><span class="blob blob-b"></span>
  <div class="container">
    <div class="row"><div class="col-lg-8" data-aos="fade-up">
      <span class="eyebrow"><i class="bi bi-journal-richtext"></i> Isarene Blog</span>
      <h1 class="section-title mt-3" style="font-size:clamp(2rem,4vw,3rem);">Guides and tips for families choosing home care</h1>
      <p class="section-sub mt-3">Practical advice for families across Massachusetts as they care for the people they love.</p>
    </div></div>
  </div>
</header>
<section class="section-pad pt-4" id="posts">
  <div class="container"><div class="row g-4">
    <% posts.forEach(function (p, i) { %><div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= (i % 3) * 80 %>"><%- include('../partials/postcard', { p: p }) %></div><% }) %>
  </div></div>
</section>
<%- include('../partials/footer') %>
